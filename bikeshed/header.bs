<style>
/* Numbered lists from Word: the label (a), 1), 1.2 … comes from data-label, so a list restarts and
   continues as it did in the source, and keeps its indentation. */
ol.wl, ul.wl { list-style: none; padding-left: 0; }
.wl > li { position: relative; padding-left: var(--wl-hang, 1.5em); }
.wl > li::before { content: attr(data-label); position: absolute; left: 0; }

/* An equation written as text in the source keeps its tabs and line breaks. */
p.equation-text { white-space: pre-wrap; tab-size: 4; }

/* Bibliography: the entry number [1] is in the text, so no bullet; later lines hang under the entry. */
ul.bibliography { list-style: none; padding-left: 0; }
ul.bibliography > li { padding-left: 3em; text-indent: -3em; margin-bottom: .3em; }

/* Terms and definitions: the number, the term and the definition each on their own line. */
dt.term .term-number { display: block; font-weight: normal; }
dt.term dfn { display: block; font-style: normal; font-weight: bold; }

/* Footnotes: a small reference mark in the text and the notes listed under their clause. */
sup.footnote-ref { font-size: 75%; line-height: 0; }
div.footnotes { border-top: 1px solid #999; margin-top: 1.5em; padding-top: .3em; font-size: 85%; }
div.footnotes ol { margin: 0; padding-left: 1.6em; }

/* The document title repeated above the first clause. */
p.main-title { font-weight: bold; font-size: 130%; margin: 1.2em 0 .2em; }  /* the paragraph's own look, from Word, overrides this */

/* A table without borders only lays text out: no grid, no header look, no highlighting. */
table.layout { border-collapse: collapse; border: none; }
table.layout td, table.layout th { border: none; background: none; padding: .1em .8em .1em 0; font-weight: normal; vertical-align: top; }
table.layout tr:hover td { background: none; }

/* Section numbers in the table of contents: one size at every depth. */
.toc .secno { font-size: 100% !important; }
